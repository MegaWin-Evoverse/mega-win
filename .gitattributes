# Normalize line endings: store as LF in the repo and check out as LF everywhere.
# Fixes prettier (endOfLine: lf) failing on CRLF working copies on Windows.
* text=auto eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
